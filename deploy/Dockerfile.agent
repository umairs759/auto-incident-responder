# Hardened Endpoint Agent container with necessary host capabilities
FROM python:3.11-slim

WORKDIR /app

# Install iptables, procps, and iproute2 for active defense operations
RUN apt-get update && apt-get install -y --no-install-recommends \
    iptables \
    iproute2 \
    procps \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY agent/ ./agent/
COPY config/ ./config/

ENV PYTHONUNBUFFERED=1

# Agent requires root for /proc access, SIGKILL execution, and iptables manipulation
CMD ["python", "-m", "agent.agent"]